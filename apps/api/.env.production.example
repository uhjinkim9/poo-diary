PORT=3001
WEB_URL=https://your-domain.com
NODE_ENV=production

# PostgreSQL — 관리형 DB (RDS, Supabase 등) 권장
DB_HOST=your-prod-db-host.rds.amazonaws.com
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_strong_db_password
DB_NAME=poo_diary
DB_SSL=true

# Mercury Lab OIDC (callback URI must match exactly in Keycloak)
OIDC_ISSUER=https://accounts.mercury-lab.uk/realms/mercury
OIDC_CLIENT_ID=poo-diary-web
APP_BASE_URL=https://poo-diary.mercury-lab.uk
OIDC_REDIRECT_URI=https://poo-diary.mercury-lab.uk/api/auth/callback/keycloak
OIDC_POST_LOGOUT_REDIRECT_URI=https://poo-diary.mercury-lab.uk/
MERCURY_IDENTITY_API_URL=
MERCURY_IDENTITY_ACCOUNT_LINK_PATH=/v1/service-accounts/link
MERCURY_IDENTITY_CLIENT_ID=poo-diary-api
MERCURY_IDENTITY_CLIENT_SECRET=
DB_MIGRATIONS_RUN=true
OIDC_MIGRATION_MODE=prompt
OIDC_REMINDER_DAYS=3

# Secret values (never commit real values)
# openssl rand -base64 32
OIDC_SESSION_ENCRYPTION_KEY=base64-encoded-32-byte-key
# openssl rand -base64 48
DEVICE_SESSION_SECRET=at-least-32-random-characters
# Optional when the Keycloak client is confidential
OIDC_CLIENT_SECRET=
