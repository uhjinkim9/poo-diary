PORT=3001
WEB_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=poo_diary
DB_SSL=false

# Local auth/OIDC
APP_BASE_URL=http://localhost:3000
OIDC_ISSUER=https://accounts.mercury-lab.uk/realms/mercury
OIDC_CLIENT_ID=poo-diary-web
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback/keycloak
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
MERCURY_IDENTITY_API_URL=
MERCURY_IDENTITY_ACCOUNT_LINK_PATH=/v1/service-accounts/link
MERCURY_IDENTITY_CLIENT_ID=poo-diary-api
MERCURY_IDENTITY_CLIENT_SECRET=
DEVICE_SESSION_SECRET=replace-with-at-least-32-random-characters
OIDC_SESSION_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
DB_MIGRATIONS_RUN=false
OIDC_MIGRATION_MODE=prompt
OIDC_REMINDER_DAYS=3
