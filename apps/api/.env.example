PORT=3001
WEB_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=poo_diary
DB_SSL=false

# Local auth/OIDC
APP_BASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=poo-diary-web
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
MERCURY_IDENTITY_API_URL=
MERCURY_IDENTITY_ACCOUNT_LINK_PATH=
MERCURY_IDENTITY_CLIENT_ID=
MERCURY_IDENTITY_CLIENT_SECRET=
DEVICE_SESSION_SECRET=replace-with-at-least-32-random-characters
OIDC_SESSION_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# 푸다이어리 앱 세션 상한(일). Keycloak의 SSO Session Idle/Max도 함께 설정해야 합니다.
OIDC_APP_SESSION_DAYS=30
DB_MIGRATIONS_RUN=false
OIDC_MIGRATION_MODE=prompt
OIDC_REMINDER_DAYS=3

OIDC_SESSION_ENCRYPTION_KEY=base64-encoded-32-byte-key
DEVICE_SESSION_SECRET=at-least-32-random-characters
OIDC_CLIENT_SECRET=
